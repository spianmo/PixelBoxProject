#!/usr/bin/env python3
"""macOS/Linux 兼容 flock；支持 NuttX apps 使用的文件锁命令形式。"""
from __future__ import annotations

import fcntl
import os
import shlex
import subprocess
import sys
import time


def usage() -> int:
    print("usage: flock [-n|-w seconds] [-s|-x] lockfile command...", file=sys.stderr)
    print("       flock [-n|-w seconds] [-s|-x] lockfile -c 'command'", file=sys.stderr)
    return 2


def main(argv: list[str]) -> int:
    shared = False
    non_blocking = False
    timeout: float | None = None
    command: list[str] | None = None
    index = 0
    while index < len(argv):
        option = argv[index]
        if option == "--":
            index += 1
            break
        if option in ("-s", "--shared"):
            shared = True
        elif option in ("-x", "--exclusive"):
            shared = False
        elif option in ("-n", "--nonblock"):
            non_blocking = True
        elif option in ("-w", "--timeout"):
            index += 1
            if index >= len(argv):
                return usage()
            try:
                timeout = float(argv[index])
            except ValueError:
                return usage()
        elif option == "-c":
            index += 1
            if index >= len(argv):
                return usage()
            command = ["/bin/sh", "-c", argv[index]]
        elif option.startswith("-"):
            return usage()
        else:
            break
        index += 1
    if index >= len(argv):
        return usage()
    lockfile = argv[index]
    index += 1
    if command is None:
        if index < len(argv) and argv[index] == "-c":
            if index + 1 >= len(argv):
                return usage()
            command = ["/bin/sh", "-c", argv[index + 1]]
            index += 2
            if index < len(argv):
                return usage()
        else:
            command = argv[index:]
    elif index < len(argv):
        return usage()
    if not command:
        return usage()

    try:
        lock = open(lockfile, "a+")
    except OSError as error:
        print(f"flock: {error}", file=sys.stderr)
        return 1
    with lock:
        mode = fcntl.LOCK_SH if shared else fcntl.LOCK_EX
        if non_blocking:
            mode |= fcntl.LOCK_NB
        deadline = None if timeout is None else time.monotonic() + max(0.0, timeout)
        while True:
            try:
                fcntl.flock(lock.fileno(), mode)
                break
            except BlockingIOError:
                if non_blocking or deadline is not None and time.monotonic() >= deadline:
                    return 1
                time.sleep(0.05)
        try:
            completed = subprocess.run(command, check=False)
            return completed.returncode
        except OSError as error:
            print(f"flock: {shlex.join(command)}: {error}", file=sys.stderr)
            return 127


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
