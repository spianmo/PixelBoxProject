# 基于 Apache NuttX 12.9.0 esp32s3-devkit:nsh；16MB Flash + 8MB octal PSRAM。
# NuttX Simple Boot 从 0x0 启动，不使用 ESP-IDF bootloader/分区表。
CONFIG_ESP32S3_APP_FORMAT_LEGACY=n
CONFIG_ESP32S3_APP_FORMAT_MCUBOOT=n
CONFIG_ESPRESSIF_SIMPLE_BOOT=y
CONFIG_BUILD_FLAT=y
CONFIG_ARCH_CHIP_ESP32S3WROOM1N4=n
CONFIG_ARCH_CHIP_ESP32S3WROOM1N16R8=y
CONFIG_ESP32S3_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_BOOT_INIT=y
CONFIG_ESP32S3_SPIRAM_MODE_OCT=y
CONFIG_ESP32S3_SPIRAM_COMMON_HEAP=y
# 与本板 ESP-IDF 配置相同的 80MHz PSRAM；上游 MSPI 启动执行时序校准。
CONFIG_ESP32S3_SPIRAM_SPEED_40M=n
CONFIG_ESP32S3_SPIRAM_SPEED_80M=y
CONFIG_ESP32S3_FLASH_FREQ_40M=n
CONFIG_ESP32S3_FLASH_FREQ_80M=y
CONFIG_ESPRESSIF_FLASH_FREQ_40M=n
CONFIG_ESPRESSIF_FLASH_FREQ_80M=y
# 与原ESP-IDF一致使用四线Flash取指；SimpleBoot仍由ROM以DIO载入，
# RAM中的官方启动流程验证QE后才切QIO，失败时保留DIO。
CONFIG_ESP32S3_FLASH_MODE_DIO=n
CONFIG_ESP32S3_FLASH_MODE_QIO=y
CONFIG_ESPRESSIF_FLASH_MODE_DIO=n
CONFIG_ESPRESSIF_FLASH_MODE_QIO=y
# 解释器与像素缓冲同时工作，扩大缓存并按64字节行减少连续像素访问缺失。
CONFIG_ESP32S3_INSTRUCTION_CACHE_16KB=n
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_32KB=n
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_32B=n
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# 30FPS 的帧周期约33ms；1ms调度粒度同时提高真机帧耗时测量精度。
CONFIG_USEC_PER_TICK=1000
# Wi-Fi 的 DMA/内部对象不能从 PSRAM 分配；使用 NuttX 官方独立 DRAM 堆。
CONFIG_XTENSA_IMEM_USE_SEPARATE_HEAP=y
# 独立内部堆供 Wi-Fi/I2S/DMA 使用；它从 _sheap 起始，不能越过本板
# ROM 的 dram0_rtos_reserved_start（0x3fceee34）。0x2d000 经 ELF 门禁
# 留出至少 4096B 尾区，同时保持 MultiNet7 的 DMA 分配空间。
CONFIG_XTENSA_IMEM_REGION_SIZE=0x2d000
CONFIG_MM_REGIONS=3
CONFIG_INTERPRETERS_PIXELBOX=y
CONFIG_INIT_ENTRYPOINT="pixelbox_boot_main"
# BLE/Wi-Fi 与任务栈共用内部堆；VM 32KiB，QuickJS 限制16KiB，保留网络/音频空间。
CONFIG_INTERPRETERS_PIXELBOX_STACKSIZE=32768
CONFIG_STACK_COLORATION=y
# 启动/NSH只保留8KiB；通过 /proc 记录真机栈高水位。
CONFIG_INIT_STACKSIZE=8192
# 新建内核任务不得把VM的fd>2覆盖进共享内核组；跨组资源显式持有文件对象。
CONFIG_FDCLONE_STDIO=y
CONFIG_BOARD_LATE_INITIALIZE=y
CONFIG_NSH_ARCHINIT=n
# 串口诊断 eval 可直接运行 API 回归，不必在数据分区落测试文件。
CONFIG_LINE_MAX=1024
# The target box exposes the native ESP32-S3 USB Serial/JTAG port, not UART0.
CONFIG_ESP32S3_USBSERIAL=y
CONFIG_UART0_SERIAL_CONSOLE=n
# 原生 USB 控制台同时接收板级初始化日志，避免日志落到未连接的 UART。
CONFIG_SYSLOG_CONSOLE=y
CONFIG_SYSLOG_DEFAULT=n
CONFIG_BOARDCTL=y
CONFIG_BOARDCTL_RESET=y
# 硬件狗由PixelBox按每个VM的真实进展喂养，不允许通用自动喂狗掩盖阻塞。
CONFIG_WATCHDOG=y
CONFIG_ESP32S3_MWDT0=y
CONFIG_WATCHDOG_AUTOMONITOR=n
CONFIG_WATCHDOG_PANIC_NOTIFIER=n
# CO5300 QSPI 面板通过 NuttX framebuffer lower-half 暴露为 /dev/fb0。
CONFIG_DRIVERS_VIDEO=y
CONFIG_VIDEO_FB=y
CONFIG_VIDEO_FB_NPOLLWAITERS=2
CONFIG_FB_UPDATE=y
CONFIG_INTERPRETERS_PIXELBOX_FRAMEBUFFER=y
CONFIG_INTERPRETERS_PIXELBOX_FB_DEVICE="/dev/fb0"
# QuickJS 依赖 log1p/hypot/lrint，使用独立 Xtensa 工具链的完整数学库。
CONFIG_LIBM=n
CONFIG_LIBM_TOOLCHAIN=y
CONFIG_LIBC_FLOATINGPOINT=y
CONFIG_LIBC_LOCALTIME=y
CONFIG_LIBC_LONG_LONG=y
CONFIG_DEV_URANDOM=y
CONFIG_ESP32S3_RNG=y
CONFIG_ESP32S3_EFUSE=y
CONFIG_FS_PROCFS=y
CONFIG_FS_LITTLEFS=y
CONFIG_ESP32S3_SPIFLASH=y
CONFIG_ESP32S3_SPIFLASH_SMARTFS=n
CONFIG_ESP32S3_SPIFLASH_LITTLEFS=n
CONFIG_ESP32S3_STORAGE_MTD_OFFSET=0x800000
CONFIG_ESP32S3_STORAGE_MTD_SIZE=0x800000
# 仅注册 /dev/esp32s3flash；应用挂载已有 littlefs，禁止启动时自动格式化。
CONFIG_PSEUDOFS_SOFTLINKS=y
CONFIG_FS_NEPOLL_DESCRIPTORS=4
CONFIG_SCHED_WAITPID=y
# 板级 bring-up 会注册 /dev/timer0；启用通用 timer lower-half 以提供该实现。
CONFIG_TIMER=y
# ESP32 Wi-Fi 适配层使用 task_tls_* 保存每个任务的同步对象。
# 微雪 2.16 的共享 I2C 总线：SDA=GPIO15，SCL=GPIO14，400 kHz。
# 启用 NuttX 官方 i2c 工具后，可在真机 NSH 执行 `i2c dev -b 0 -z 0x03 0x77` 扫描，
# 并用 `i2c get -b 0 -a 6b -r 00` 读取 QMI8658 WHO_AM_I。
CONFIG_ESP32S3_I2C0=y
CONFIG_I2C_DRIVER=y
CONFIG_ESP32S3_I2C0_SCLPIN=14
CONFIG_ESP32S3_I2C0_SDAPIN=15
CONFIG_SYSTEM_I2CTOOL=y
CONFIG_I2CTOOL_MINBUS=0
CONFIG_I2CTOOL_MAXBUS=0
CONFIG_I2CTOOL_MINADDR=0x03
CONFIG_I2CTOOL_MAXADDR=0x77
CONFIG_I2CTOOL_DEFFREQ=400000
# 微雪 2.16: ES8311 播放链路与 ESP32-S3 I2S0 共用 GPIO42/9/45/8。
# ES7210在共享I2S输入GPIO10；板级codec配置与内部SRAM DMA配合双工时钟。
CONFIG_ESP32S3_I2S=y
CONFIG_ESP32S3_I2S0=y
CONFIG_ESP32S3_I2S0_RX=y
CONFIG_ESP32S3_I2S0_TX=y
CONFIG_ESP32S3_I2S0_MCLK=y
CONFIG_ESP32S3_I2S0_MCLKPIN=42
CONFIG_ESP32S3_I2S0_BCLKPIN=9
CONFIG_ESP32S3_I2S0_WSPIN=45
CONFIG_ESP32S3_I2S0_DOUTPIN=8
CONFIG_ESP32S3_I2S0_DINPIN=10
CONFIG_ESP32S3_I2S0_SAMPLE_RATE=16000
CONFIG_AUDIO=y
CONFIG_DRIVERS_AUDIO=y
CONFIG_AUDIO_ES8311=y
CONFIG_AUDIO_I2S=y
CONFIG_AUDIO_I2SCHAR=y
CONFIG_SCHED_WORKQUEUE=y
# NuttX 原生 ESP32-S3 WLAN 与 IPv4/TCP/UDP 协议栈。
CONFIG_DRIVERS_WIRELESS=y
CONFIG_DRIVERS_IEEE80211=y
CONFIG_ESPRESSIF_WIFI=y
CONFIG_ESPRESSIF_WIFI_STATION=y
CONFIG_NET=y
CONFIG_NET_IPv4=y
CONFIG_NET_TCP=y
# poll 驱动的监听器依赖 backlog 保存已握手连接；发送队列必须不等待网络 ACK。
CONFIG_NET_TCPBACKLOG=y
CONFIG_NET_TCP_WRITE_BUFFERS=y
CONFIG_NET_UDP=y
CONFIG_NET_IGMP=y
# BLE host 与 station 同时运行；控制器内部对象使用独立 DRAM 堆。
CONFIG_ALLOW_BSD_COMPONENTS=y
CONFIG_WIRELESS=y
CONFIG_ESPRESSIF_BLE=y
CONFIG_DRIVERS_BLUETOOTH=y
CONFIG_WIRELESS_BLUETOOTH=y
CONFIG_NET_BLUETOOTH=y
CONFIG_NETDEV_IFINDEX=y
CONFIG_NETDEV_IOCTL=y
CONFIG_WIRELESS_BLUETOOTH_HOST=n
CONFIG_NIMBLE=y
CONFIG_NIMBLE_REF="fb15c844542e812ceb49ab5ac8502dc93c167b90"
CONFIG_NIMBLE_ROLE_BROADCASTER=y
CONFIG_NIMBLE_ROLE_CENTRAL=y
CONFIG_NIMBLE_ROLE_OBSERVER=y
CONFIG_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_NIMBLE_PORTING_EXAMPLE=n
CONFIG_NIMBLE_TINYCRYPT=y
CONFIG_NIMBLE_BLE_MAX_CONN=3
CONFIG_NIMBLE_BLE_ATT_PREFFERED_MTU=256
CONFIG_NIMBLE_CALLOUT_THREAD_STACKSIZE=4096
CONFIG_SIG_EVTHREAD=y
CONFIG_DISABLE_POSIX_TIMERS=n
CONFIG_NET_BROADCAST=y
CONFIG_NET_ETH_PKTSIZE=1518
CONFIG_NETDEV_LATEINIT=y
CONFIG_NETDEV_PHY_IOCTL=y
CONFIG_NETDEV_WIRELESS_IOCTL=y
CONFIG_NET_ICMP_SOCKET=y
CONFIG_NETDB_DNSCLIENT=y
CONFIG_NETUTILS_DHCPC=y
CONFIG_NETINIT_DHCPC=y
# ESP32-S3 Wi-Fi 适配器为每个任务保存信号量，需要至少一个任务本地 TLS 槽位；
# 与 NuttX 官方 esp32s3-devkit:wifi 配置保持一致，预留 4 个槽位。
CONFIG_TLS_TASK_NELEM=4
# Wi-Fi API 锁依赖递归 mutex；未启用时 settype 返回 ENOSYS，库误报 ENOMEM。
CONFIG_PTHREAD_MUTEX_TYPES=y
# CO5300 QSPI: CS=12 CLK=38 D0..D3=4/5/6/7；SPI2 的 QIO 模式。
CONFIG_ESP32S3_SPI2=y
CONFIG_ESP32S3_SPI_IO_QIO=y
CONFIG_ESP32S3_SPI_DMA=y
# CO5300 像素流按 20 行一批提交；减少 RAMWRC 事务，同时给内部堆保留安全尾部。
# 20*480*2=19200 字节，底层 QSPI 会按 4092 字节 DMA 描述符自动拆分。
CONFIG_ESP32S3_SPI_DMA_BUFSIZE=20480
CONFIG_ESP32S3_SPI2_CSPIN=12
CONFIG_ESP32S3_SPI2_CLKPIN=38
CONFIG_ESP32S3_SPI2_MOSIPIN=4
CONFIG_ESP32S3_SPI2_MISOPIN=5
CONFIG_ESP32S3_SPI2_IO2PIN=6
CONFIG_ESP32S3_SPI2_IO3PIN=7
