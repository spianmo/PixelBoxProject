{
  "name": "pixelbox-simulator",
  "version": "0.1.0",
  "description": "PixelBox 像素盒模拟器 IDE(Electron)",
  "main": "./out/main/index.js",
  "author": "PixelBox",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "build": "pnpm run typecheck && rsbuild build",
    "start": "electron .",
    "selfcheck": "node scripts/selfcheck.mjs",
    "check:toolchain": "node scripts/toolchain-check.mjs",
    "check:clangd": "node scripts/clangd-check.mjs",
    "check:terminal": "node scripts/terminal-check.mjs",
    "check:settings": "node scripts/settings-check.mjs",
    "check:fullscreen": "node scripts/fullscreen-visual-check.mjs",
    "check:lights": "node scripts/traffic-lights-diff-check.mjs",
    "postinstall": "node scripts/pty-postinstall.mjs",
    "rebuild:pty": "electron-rebuild -f -w node-pty",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "check:hardware": "node scripts/hardware-eval-check.mjs"
  },
  "dependencies": {
    "basic-ftp": "^6.2.0",
    "bonjour-service": "^1.3.0",
    "chokidar": "^3.6.0",
    "esbuild": "^0.24.2",
    "mqtt": "^5.15.2",
    "openscad-wasm-prebuilt": "^1.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@rsbuild/core": "^2.1.10",
    "@rsbuild/plugin-react": "^2.1.0",
    "@tscircuit/circuit-json-util": "0.0.105",
    "@tscircuit/core": "0.0.1607",
    "@tscircuit/eval": "0.0.1137",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.185.4",
    "@types/ws": "^8.5.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "circuit-json": "0.0.465",
    "circuit-json-to-gerber": "0.0.90",
    "circuit-to-svg": "0.0.393",
    "comlink": "4.4.2",
    "dompurify": "^3.4.13",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "fast-png": "^6.2.0",
    "gifuct-js": "^2.1.2",
    "i18next": "^23.16.8",
    "jpeg-js": "^0.4.4",
    "markdown-it": "^14.3.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.1.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-icons": "^5.4.0",
    "tailwindcss": "^3.4.17",
    "three": "0.185.1",
    "typescript": "^5.7.2",
    "zod": "^3.25.76"
  }
}
