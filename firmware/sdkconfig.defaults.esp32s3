# Default S3 firmware: standalone speech, 16 MiB flash / 8 MiB PSRAM.
# ESP-IDF automatically applies this after sdkconfig.defaults for esp32s3.
CONFIG_PX_ENABLE_SPEECH=y
CONFIG_PX_ENABLE_WAKEWORD=n
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_speech.csv"
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
CONFIG_SR_MN_EN_NONE=y
CONFIG_SR_WN_WN9_HILEXIN=n
CONFIG_SR_WN_WN9_HIESP=n
CONFIG_JSVM_MEM_LIMIT_KB=2048
# Keep medium model/network allocations out of scarce internal RAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
# Allow several TLS records in flight for voice uploads and responses.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=14
# DHCP DNS 不可用时使用 lwIP 自带的备用解析器，保留主/次 DNS。
CONFIG_LWIP_FALLBACK_DNS_SERVER_SUPPORT=y
CONFIG_LWIP_FALLBACK_DNS_SERVER_ADDRESS="1.1.1.1"
# 为唤醒模型与并行 TLS 留出内部 DMA 内存；每个静态 Wi-Fi 缓冲约 1.6 KiB。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6
