menu "PixelBox JSVM"

    config JSVM_MEM_LIMIT_KB
        int "JS 堆上限 (KB)"
        default 256 if !SPIRAM
        default 4096
        help
            QuickJS 运行时内存上限。分配经自定义分配器
            (hal_common/px_alloc.h) 优先落 PSRAM, 无 PSRAM 目标 (C6 /
            关闭 SPIRAM 时) 自动落内部堆 —— 此时默认收缩到 256KB,
            为帧缓冲/网络栈保留内部内存余量。
            按目标默认: S3 (8MB PSRAM) / P4 (PSRAM) = 4096; C6 = 256。

    config JSVM_TASK_STACK_KB
        int "js_task 栈大小 (KB)"
        default 32
        help
            JS 唯一执行线程的栈。QuickJS 的栈溢出检查阈值会按
            (本值 - 12KB) 自动适配, 保证原生侧仍有安全余量。

    config JSVM_TASK_STACK_IN_PSRAM
        bool "js_task 栈分配在 PSRAM (谨慎开启)"
        default n
        help
            注意: js_task 会直接执行 littlefs 文件读写 (加载应用入口 /
            readAsset / px.storage.fs)。SPI flash 操作期间 cache 被关闭,
            栈在 PSRAM 的任务此时访问栈会触发崩溃, 因此默认栈放内部 RAM。
            仅当确认 JS 线程完全不触碰 flash (或启用了 flash 自动挂起
            特性) 时才可开启本选项以节省内部内存。

    config JSVM_TASK_CORE
        int "js_task 绑定核心"
        range 0 0 if FREERTOS_UNICORE
        range 0 1
        default 0 if FREERTOS_UNICORE
        default 1
        help
            双核目标 (S3/P4) 默认核 1 (核 0 留给 WiFi/音频);
            单核目标 (C6) 恒为核 0。

    config JSVM_TASK_PRIORITY
        int "js_task 优先级"
        default 5

    config JSVM_QUEUE_DEPTH
        int "事件队列深度"
        default 64

endmenu
