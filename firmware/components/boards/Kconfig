menu "PixelBox Board"

    choice BOARD_TYPE
        prompt "板型选择"
        default BOARD_WAVESHARE_AMOLED_18 if IDF_TARGET_ESP32S3
        default BOARD_GENERIC_SPI if IDF_TARGET_ESP32C6
        default BOARD_HEADLESS
        help
            选择目标硬件板型。所有引脚定义收敛在板型文件中。
            微雪板与定制 PCB 依赖 S3 外设 (QSPI AMOLED/Octal PSRAM),
            仅在 esp32s3 目标可选; 其他目标 (C6/P4) 请选通用 SPI 屏或无屏板。

        config BOARD_WAVESHARE_AMOLED_18
            bool "微雪 ESP32-S3-Touch-AMOLED-1.8 (SH8601/FT3168/ES8311/QMI8658/AXP2101)"
            depends on IDF_TARGET_ESP32S3

        config BOARD_CUSTOM_V1
            bool "PixelBox 定制 PCB v1 (Stage B)"
            depends on IDF_TARGET_ESP32S3

        config BOARD_GENERIC_SPI
            bool "通用 SPI 屏开发板 (ST7789 240x240, 引脚全 Kconfig; C6/P4 等)"
            help
                任意 ESP32 系列开发板 + 单线 SPI ST7789 TFT (esp_lcd 内置驱动)。
                无触摸/IMU/PMU/codec, 对应能力位如实返回 false。
                帧缓冲与行带 (strip) 中转缓冲按 px_alloc 策略分配
                (无 PSRAM 目标落内部堆, 行带 flush 见 hal_display Kconfig)。

        config BOARD_HEADLESS
            bool "无屏调试板 (px.screen 报 ENOTSUP; P4/C6 裸板调试用)"
            help
                无任何板载外设的裸开发板 (如 ESP32-P4 Function EV Board
                不接屏)。px.screen 所有绘图调用抛 Error("ENOTSUP"),
                system.info().screen 为 0x0, 其余能力位全 false。
    endchoice

    if BOARD_WAVESHARE_AMOLED_18

        comment "―― 微雪 AMOLED-1.8 引脚 (默认值取自官方例程 pin_config.h) ――"

        config BOARD_WS18_I2C_SDA
            int "I2C SDA (触摸/codec/PMU/IMU/RTC 共用总线)"
            default 15
        config BOARD_WS18_I2C_SCL
            int "I2C SCL"
            default 14
        config BOARD_WS18_I2C_FREQ_KHZ
            int "I2C 速率 (kHz)"
            default 400

        config BOARD_WS18_TP_INT
            int "触摸中断 TP_INT"
            default 21

        config BOARD_WS18_LCD_CS
            int "屏幕 QSPI CS"
            default 12
        config BOARD_WS18_LCD_SCLK
            int "屏幕 QSPI SCLK"
            default 11
        config BOARD_WS18_LCD_D0
            int "屏幕 QSPI SDIO0"
            default 4
        config BOARD_WS18_LCD_D1
            int "屏幕 QSPI SDIO1"
            default 5
        config BOARD_WS18_LCD_D2
            int "屏幕 QSPI SDIO2"
            default 6
        config BOARD_WS18_LCD_D3
            int "屏幕 QSPI SDIO3"
            default 7
        config BOARD_WS18_LCD_PCLK_MHZ
            int "屏幕 QSPI 像素时钟 (MHz)"
            default 40

        config BOARD_WS18_I2S_MCLK
            int "I2S MCLK"
            default 16
        config BOARD_WS18_I2S_BCLK
            int "I2S BCLK"
            default 9
        config BOARD_WS18_I2S_WS
            int "I2S WS (LRCK)"
            default 45
        config BOARD_WS18_I2S_DOUT
            int "I2S DOUT (ESP32 → codec 播放)"
            default 10
            help
                默认值依据官方例程 (DOPIN=10 / DIPIN=8);
                官方头文件中另一组宏方向命名相反, 若播放/录音颠倒请与 DIN 互换。待上板核对。
        config BOARD_WS18_I2S_DIN
            int "I2S DIN (codec → ESP32 麦克风)"
            default 8
        config BOARD_WS18_PA_ENABLE
            int "功放使能 PA"
            default 46

        comment "―― TCA9554 IO 扩展器 (EXIO 编号 0-7) ――"

        config BOARD_WS18_EXIO_TP_RST
            int "触摸复位所在 EXIO"
            default 1
            help
                官方例程将 EXIO1/EXIO2 同时做复位释放 (先拉低再拉高),
                未区分触摸/屏幕先后; 编号归属待上板核对。
        config BOARD_WS18_EXIO_LCD_RST
            int "屏幕复位所在 EXIO"
            default 2
        config BOARD_WS18_EXIO_KEY
            int "侧键输入所在 EXIO"
            default 4
        config BOARD_WS18_EXIO_PMU_IRQ
            int "PMU 中断输入所在 EXIO"
            default 5

        config BOARD_WS18_BOOT_GPIO
            int "BOOT 按键 GPIO"
            default 0

    endif # BOARD_WAVESHARE_AMOLED_18

    if BOARD_CUSTOM_V1

        comment "―― 定制 PCB v1 引脚 (Stage B, 打板后按原理图填写) ――"

        config BOARD_CV1_I2C_SDA
            int "I2C SDA"
            default 15
        config BOARD_CV1_I2C_SCL
            int "I2C SCL"
            default 14
        config BOARD_CV1_I2C_FREQ_KHZ
            int "I2C 速率 (kHz)"
            default 400
        config BOARD_CV1_TP_INT
            int "触摸中断 TP_INT (-1 = 无)"
            default 21
        config BOARD_CV1_LCD_CS
            int "屏幕 QSPI CS"
            default 12
        config BOARD_CV1_LCD_SCLK
            int "屏幕 QSPI SCLK"
            default 11
        config BOARD_CV1_LCD_D0
            int "屏幕 QSPI SDIO0"
            default 4
        config BOARD_CV1_LCD_D1
            int "屏幕 QSPI SDIO1"
            default 5
        config BOARD_CV1_LCD_D2
            int "屏幕 QSPI SDIO2"
            default 6
        config BOARD_CV1_LCD_D3
            int "屏幕 QSPI SDIO3"
            default 7
        config BOARD_CV1_LCD_RST
            int "屏幕复位 GPIO (-1 = 无/扩展器)"
            default -1
        config BOARD_CV1_LCD_PCLK_MHZ
            int "屏幕 QSPI 像素时钟 (MHz)"
            default 40
        config BOARD_CV1_I2S_MCLK
            int "I2S MCLK"
            default 16
        config BOARD_CV1_I2S_BCLK
            int "I2S BCLK"
            default 9
        config BOARD_CV1_I2S_WS
            int "I2S WS"
            default 45
        config BOARD_CV1_I2S_DOUT
            int "I2S DOUT"
            default 10
        config BOARD_CV1_I2S_DIN
            int "I2S DIN"
            default 8
        config BOARD_CV1_PA_ENABLE
            int "功放使能 (-1 = 无)"
            default 46
        config BOARD_CV1_BOOT_GPIO
            int "BOOT 按键 GPIO"
            default 0

        config BOARD_CV1_HAS_AXP2101
            bool "板载 AXP2101 PMU"
            default y

        comment "―― Stage B 可选外设开关 (默认关, available() 返回 false) ――"

        config BOARD_CV1_HAS_CAMERA
            bool "OV2640 摄像头 (DVP)"
            default n
        config BOARD_CV1_HAS_GPS
            bool "ATGM336H GPS (UART)"
            default n
        config BOARD_CV1_HAS_LED
            bool "WS2812 灯带"
            default n

    endif # BOARD_CUSTOM_V1

    if BOARD_GENERIC_SPI

        comment "―― 通用 SPI 屏 (ST7789) 引脚 — 默认值面向 ESP32-C6 DevKit, 按实际接线修改 ――"

        config BOARD_GSPI_LCD_WIDTH
            int "屏幕宽 (px)"
            default 240
        config BOARD_GSPI_LCD_HEIGHT
            int "屏幕高 (px)"
            default 240
        config BOARD_GSPI_LCD_SCLK
            int "SPI SCLK"
            default 6
        config BOARD_GSPI_LCD_MOSI
            int "SPI MOSI"
            default 7
        config BOARD_GSPI_LCD_CS
            int "SPI CS"
            default 18
        config BOARD_GSPI_LCD_DC
            int "DC (数据/命令)"
            default 19
        config BOARD_GSPI_LCD_RST
            int "复位 (-1 = 未接)"
            default 20
        config BOARD_GSPI_LCD_BACKLIGHT
            int "背光 (-1 = 常亮/未接; 接 GPIO 时用 LEDC PWM 调亮度)"
            default 21
        config BOARD_GSPI_LCD_PCLK_MHZ
            int "SPI 像素时钟 (MHz)"
            default 40
            help
                ST7789 典型 40MHz; 杜邦线飞线不稳时降到 20。
        config BOARD_GSPI_LCD_X_OFFSET
            int "面板 X 偏移 (esp_lcd set_gap)"
            default 0
        config BOARD_GSPI_LCD_Y_OFFSET
            int "面板 Y 偏移 (240x240 圆角屏常见 0 或 80, 视扫描方向)"
            default 0
        config BOARD_GSPI_LCD_INVERT_COLOR
            bool "颜色反转 (多数 ST7789 IPS 屏需要开)"
            default y
        config BOARD_GSPI_LCD_BGR
            bool "BGR 子像素顺序 (颜色红蓝颠倒时切换)"
            default n

        config BOARD_GSPI_HAS_I2C
            bool "启用共享 I2C 总线 (外接传感器等)"
            default n
        if BOARD_GSPI_HAS_I2C
            config BOARD_GSPI_I2C_SDA
                int "I2C SDA"
                default 4
            config BOARD_GSPI_I2C_SCL
                int "I2C SCL"
                default 5
            config BOARD_GSPI_I2C_FREQ_KHZ
                int "I2C 速率 (kHz)"
                default 400
        endif

        config BOARD_GSPI_BOOT_GPIO
            int "BOOT 按键 GPIO"
            default 9 if IDF_TARGET_ESP32C6
            default 35 if IDF_TARGET_ESP32P4
            default 0

    endif # BOARD_GENERIC_SPI

    if BOARD_HEADLESS

        config BOARD_HEADLESS_BOOT_GPIO
            int "BOOT 按键 GPIO (-1 = 无)"
            default 9 if IDF_TARGET_ESP32C6
            default 35 if IDF_TARGET_ESP32P4
            default 0

    endif # BOARD_HEADLESS

endmenu
