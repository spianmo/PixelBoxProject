menu "PixelBox 独立语音 (bindings_speech)"

config PX_ENABLE_SPEECH
    bool "启用 ESP-SR 离线命令唤醒与 Azure 直连语音"
    depends on PX_ENABLE_AUDIO && IDF_TARGET_ESP32S3
    default n
    help
        S3 默认配置启用：MultiNet7 中文模型检测你好小川，
        原生 TLS 请求 Azure STT/TTS，不依赖手机。需要 16MB flash、8MB PSRAM。
        使用 partitions_speech.csv，不能通过旧非语音布局单应用 OTA 安装。

endmenu
