{
  "name": "@pixelbox/sdk",
  "version": "0.1.0",
  "description": "PixelBox 像素盒应用开发 SDK 与 CLI:create/build/push/dev/logs/devices/eval,含 devd 协议客户端库",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pixelbox": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types/pixelbox.d.ts": "./types/pixelbox.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "pixelbox",
    "esp32",
    "quickjs",
    "iot",
    "cli"
  ],
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "esbuild": "^0.25.0",
    "picocolors": "^1.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.6.0"
  }
}
