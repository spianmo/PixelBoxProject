# ============================================================
# PixelBox 语音中继服务器配置
# 复制为 .env 后按需修改:cp .env.example .env
# 所有 *_BASE_URL 均为 OpenAI 兼容风格,需带版本前缀且不带末尾斜杠,
# 例如 https://api.openai.com/v1
# ============================================================

# ---- 通用 ----
# 监听端口(WS /realtime 与 HTTP /healthz 共用)
PORT=8787
# 连接鉴权 token,留空表示不校验;设备端 px.voice.configure({ token }) 需与此一致
VOICE_TOKEN=
# LLM 系统提示词
SYSTEM_PROMPT=你是 PixelBox 像素盒里的语音助手,回答简洁、口语化,一般不超过三句话。
# 每连接保留的最大对话轮数(1 轮 = 用户 + 助手各一条)
MAX_HISTORY_TURNS=8

# ============================================================
# 方案一:OpenAI 官方(默认启用)
# ============================================================
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=alloy
# OpenAI /audio/speech response_format=pcm 固定输出 24kHz / 16bit / 单声道
TTS_PCM_SAMPLE_RATE=24000

# ============================================================
# 方案二:硅基流动 SiliconFlow(注释掉方案一后取消注释启用)
# 注册 https://cloud.siliconflow.cn 获取 API Key
# ============================================================
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_API_KEY=sk-xxxx
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# STT_MODEL=FunAudioLLM/SenseVoiceSmall
# TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex
# # 硅基流动支持在请求中指定 pcm 输出采样率:两项保持一致即可
# TTS_PCM_SAMPLE_RATE=24000
# TTS_SAMPLE_RATE_PARAM=24000

# ============================================================
# 进阶(可选)
# ============================================================
# 三个服务可分别指向不同供应商,留空则统一用 OPENAI_BASE_URL / OPENAI_API_KEY
# 例如:STT 用硅基流动、LLM 用 DeepSeek、TTS 用 OpenAI
# STT_BASE_URL=
# STT_API_KEY=
# LLM_BASE_URL=
# LLM_API_KEY=
# TTS_BASE_URL=
# TTS_API_KEY=

# STT 识别语言提示(如 zh),留空由服务商自动检测
# STT_LANGUAGE=zh
# LLM 采样温度 / 最大生成 token(0 = 不传该字段)
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=512
# 句子级并行 TTS 的最大并发数(降低首包延迟)
# TTS_CONCURRENCY=2
# TTS 推流速度倍率(相对实时播放;0 = 不限速全速推送)
# TTS_PUSH_SPEED=4
# 三个上游请求的超时毫秒数
# STT_TIMEOUT_MS=30000
# LLM_TIMEOUT_MS=60000
# TTS_TIMEOUT_MS=30000

# ---- 服务端静默兜底 VAD(设备未发 speech.end 时由服务器判定说完)----
# 连续静音超过该毫秒数即触发 STT
# SILENCE_FALLBACK_MS=1500
# PCM16 帧 RMS 能量低于该值视为静音(0~32767)
# VAD_ENERGY_THRESHOLD=500
# 单次收音最长毫秒数,超过强制触发 STT
# MAX_UTTERANCE_MS=20000
# 有效语音最短毫秒数,低于则丢弃本轮
# MIN_SPEECH_MS=300
